# =========================================================
# TbilisiStyle21 — Environment variables
# Copy this file to .env.local and fill in the real values
# =========================================================

# ============ Database — PostgreSQL (Payload) ============
# Local dev: your local Postgres instance.
# Production (Vercel): the Neon / Vercel Postgres integration injects POSTGRES_URL
# automatically — set that there instead of DATABASE_URL.
DATABASE_URL="postgresql://user:pass@127.0.0.1:5432/tbilisistyle21"

# Payload encryption/JWT secret (generate a long random string).
PAYLOAD_SECRET=""

# Admin auto-login email shown by the Payload admin panel.
PAYLOAD_ADMIN_EMAIL="admin@example.com"

# ============ Data migration only (legacy MongoDB -> Postgres) ============
# Used solely by scripts/migrate-mongo-to-postgres.ts. NOT used by the running app.
# MIGRATE_MONGODB_URI="mongodb+srv://user:pass@cluster.xxx.mongodb.net/"
# MIGRATE_MONGODB_DB="tbilisistyle21"
# Override DNS if Atlas SRV lookups fail (querySrv ECONNREFUSED):
# MIGRATE_MONGO_DNS_SERVERS="8.8.8.8,1.1.1.1"

# ============ Quipu Payment Gateway ============
PG_API_URL="https://3dss2test.quipu.de:8000/order"
PG_MERCHANT_ID="ECOM_TEST260"
PG_TEST_TYPE_RID=""

# mTLS certificates (base64-encoded)
PG_CERT_BASE64=""
PG_KEY_BASE64=""
PG_CA_BASE64=""

# ============ App ============
# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============ Email — Resend (recommended for production) ============
# Get your API key at https://resend.com
# Configure your sending domain with DKIM/SPF/DMARC
RESEND_API_KEY=""
EMAIL_FROM_NAME="Tbilisi Style 21"
EMAIL_FROM_ADDRESS="tickets@tbilisistyle21.com"
EMAIL_REPLY_TO="support@tbilisistyle21.com"

# ============ Email — Gmail SMTP (fallback / dev only) ============
# Used automatically if RESEND_API_KEY is not set.
# Note: Gmail has a 500/day sending limit and may land in spam without DKIM.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ============ Admin Auth ============
# Use distinct values for security (do NOT let AUTH_SECRET fall back to ADMIN_PASSWORD)
ADMIN_PASSWORD=""
AUTH_SECRET=""
